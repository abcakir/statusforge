# PostgreSQL
POSTGRES_DB=statusforge
POSTGRES_USER=statusforge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://statusforge:change-me@postgres:5432/statusforge

# Redis
REDIS_URL=redis://redis:6379

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=statusforge
KEYCLOAK_CLIENT_ID=statusforge-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Backend
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=statusforge
VITE_KEYCLOAK_CLIENT_ID=statusforge-frontend
